{
  "name": "alibi",
  "license": "GPL-3.0-only",
  "dependencies": {
    "tailwindcss": "^3.4.13"
  },
  "scripts": {
    "build": "yarn build:css && node scripts/build.mjs",
    "build:store": "yarn build:css && node scripts/build.mjs --store",
    "build:companion": "node scripts/build-companion.mjs",
    "test": "node --no-warnings test/stealth.test.mjs",
    "testpage": "yarn build:css && node test/serve.mjs",
    "build:css": "tailwindcss -i ./tailwind.css -o ./css/style.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.css -o ./css/style.css --minify --watch"
  }
}
